<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Shared.SidePanel">

    <Grid BackgroundColor="#D9D9D9">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <HorizontalStackLayout Grid.Row="0" VerticalOptions="Center" Padding="10,0">
            <Image Source="icon.png" HeightRequest="40" WidthRequest="40"/>
            <Label Text="LOGO" FontSize="28" FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <!-- Menu Buttons -->
        <VerticalStackLayout Grid.Row="1" Spacing="5" Padding="0,60, 0,0">
            <Button Text="Dashboard" 
                    Command="{Binding ShowDashboardCommand}"
                    BackgroundColor="#D9D9D9"
                    TextColor="Black"
                    FontAttributes="Bold" />
            <Button Text="Menu Management" 
                    Command="{Binding ShowMenuManagementCommand}"
                    BackgroundColor="#D9D9D9"
                    TextColor="Black"
                    FontAttributes="Bold" />
            <Button Text="Staff Management" Command="{Binding ShowStaffManagementCommand}"
                    BackgroundColor="#D9D9D9"
                    TextColor="Black"
                    FontAttributes="Bold" />
            <Button Text="Reports" Command="{Binding ShowReportsCommand}"
                    BackgroundColor="#D9D9D9"
                    TextColor="Black"
                    FontAttributes="Bold" />
            <Button Text="Notification" Command="{Binding ShowNotificationCommand}"
                    BackgroundColor="#D9D9D9"
                    TextColor="Black"
                    FontAttributes="Bold" />
            <!--
            <Label Text="Employee's Tab" FontSize="10" Padding="0,20,0,5"/>
            <Button Text="Point of Sale" Command="{Binding ShowPOSCommand}"/>
            <Button Text="Kitchen Display" Command="{Binding ShowKitchenCommand}"/>
            -->
        </VerticalStackLayout>

        <!-- Footer / Sign Out -->
        <Button Text="Sign Out" Grid.Row="2" 
                Command="{Binding SignOutCommand}" 
                WidthRequest="180"
                BackgroundColor="#777777"
                TextColor="Black"
                FontAttributes="Bold" 
                HeightRequest="20"
                CornerRadius="0"/>
    </Grid>
</ContentView>
