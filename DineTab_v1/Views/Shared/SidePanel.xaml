<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Shared.SidePanel">

    <Grid BackgroundColor="#D9D9D9">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <HorizontalStackLayout Grid.Row="0" VerticalOptions="Center" Padding="10,0">
            <Image Source="icon.png" HeightRequest="40" WidthRequest="40"/>
            <Label Text="LOGO" FontSize="28" FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <!-- Menu Buttons -->
        <VerticalStackLayout Grid.Row="1" Spacing="5" Padding="10,60,0,0">
            <Button x:Name="DashboardButton" Text="Dashboard" 
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    TextColor="Black"
                    FontAttributes="Bold"/>
            <Button x:Name="MenuManagementButton" Text="Menu Management" 
                     BackgroundColor="Transparent"
                       HorizontalOptions="Start"
 TextColor="Black"
 FontAttributes="Bold"/>
            <Button x:Name="StaffManagementButton" Text="Staff Management"
                     BackgroundColor="Transparent"
                       HorizontalOptions="Start"
 TextColor="Black"
 FontAttributes="Bold"/>
            <Button x:Name="ReportsButton" Text="Reports" 
                     BackgroundColor="Transparent"
                       HorizontalOptions="Start"
 TextColor="Black"
 FontAttributes="Bold"/>
            <Button x:Name="NotificationButton" Text="Notification"
                     BackgroundColor="Transparent"
                       HorizontalOptions="Start"
 TextColor="Black"
 FontAttributes="Bold"/>
        </VerticalStackLayout>

        <!-- Footer / Sign Out -->
        <Button x:Name="SignOutButton" Text="Sign Out" Grid.Row="2" 
                WidthRequest="180"
                BackgroundColor="#777777"
                TextColor="Black"
                FontAttributes="Bold" 
                HeightRequest="20"
                CornerRadius="0"/>
    </Grid>
</ContentView>
