<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Admin.StaffManagementPage"
             >
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Header Row: Search Box and Add Account Button -->
            <Grid ColumnSpacing="10"
                  VerticalOptions="Start">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Entry stays small -->
                    <ColumnDefinition Width="*" />
                    <!-- Spacer pushes button to right -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Button auto-sized -->
                </Grid.ColumnDefinitions>

                <!-- Search Entry (fixed small width) -->
                <Border Stroke="Black">
                    <Entry x:Name="SearchBar"
                           Placeholder="Search Account..."
                           WidthRequest="200"
                           Grid.Column="0"/>
                </Border>
                <!-- Spacer -->
                <BoxView Grid.Column="1" BackgroundColor="Transparent"/>

                <!-- Add Account Button (right aligned) -->
                <Button Text="Add Account"
                        Grid.Column="2"
                        HorizontalOptions="End"
                        BackgroundColor="White"
                        CornerRadius="0"
                        TextColor="Black"
                        BorderColor="Black"
                        BorderWidth="1"
                        Command="{Binding AddAccountCommand}"/>
            </Grid>


            <!-- Filter Buttons -->
            <HorizontalStackLayout Spacing="10">
                <Button Text="All Account" 
                         BackgroundColor="White"
                         CornerRadius="0"
                         TextColor="Black"
                         BorderColor="Black"
                         BorderWidth="1"/>
                <Button Text="Admin" 
                         BackgroundColor="White"
                         CornerRadius="0"
                         TextColor="Black"
                         BorderColor="Black"
                         BorderWidth="1"/>
                <Button Text="Cashier" 
                         BackgroundColor="White"
                         CornerRadius="0"
                         TextColor="Black"
                         BorderColor="Black"
                         BorderWidth="1" />
                <Button Text="Kitchen Staff" 
                         BackgroundColor="White"
                         CornerRadius="0"
                         TextColor="Black"
                         BorderColor="Black"
                         BorderWidth="1"/>
            </HorizontalStackLayout>

            <!-- Accounts Display Section -->
            <CollectionView x:Name="StaffCollection"
                ItemsSource="{Binding StaffList}"
                Margin="0,20,0,0">
                <CollectionView.ItemsLayout>
                    <!-- 4 columns, vertical scrolling -->
                    <GridItemsLayout Orientation="Vertical"
                         Span="4" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray" Padding="15" Margin="5">
                            <VerticalStackLayout Spacing="20">
                                <!-- Avatar -->
                                <HorizontalStackLayout VerticalOptions="Center" Spacing="10">
                                    <Image Source="icon.png" HeightRequest="50"/>
                                    <VerticalStackLayout>
                                        <!-- Full Name -->
                                        <Label Text="{Binding FullName}" 
                                               FontAttributes="Bold" 
                                               FontSize="14" 
                                               HorizontalOptions="Center"/>
                                        <!-- Role -->
                                        <Label Text="{Binding Role}" 
                                             FontAttributes="Italic" 
                                             FontSize="12" 
                                             HorizontalOptions="Center" />
                                    </VerticalStackLayout>

                                </HorizontalStackLayout>

                                <!-- Account Info -->
                                <StackLayout Spacing="2" Margin="0,5,0,5" >
                                    <Grid ColumnDefinitions="Auto,*" >
                                        <Label Text="Email:" FontSize="12" Grid.Column="0" VerticalOptions="Center"/>
                                        <Label Text="{Binding Email}" FontSize="12" 
                                               TextDecorations="Underline" 
                                               Grid.Column="1"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*">
                                        <Label Text="Password:" FontSize="12" Grid.Column="0" VerticalOptions="Center"/>
                                        <Label Text="{Binding MaskedPassword}" FontSize="12"                                              
                                               Grid.Column="1"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </StackLayout>


                                <!-- Buttons -->
                                <HorizontalStackLayout Spacing="10" Padding="0, 40, 0, 0">
                                    <Button Text="Modify Account"  
                                            BackgroundColor="White"
                                            CornerRadius="0"
                                            TextColor="Black"
                                            BorderColor="Black"
                                            BorderWidth="1"
                                            Command="{Binding BindingContext.GoToModifyStaffCommand, Source={x:Reference StaffCollection}}"
                                            CommandParameter="{Binding .}"/>

                                    <Button Text="Delete"  
                                            BackgroundColor="White"
                                            CornerRadius="0"
                                            TextColor="Black"
                                            BorderColor="Black"
                                            BorderWidth="1"
                                            Command="{Binding BindingContext.GoToRemoveStaffCommand, Source={x:Reference StaffCollection}}"
                                            CommandParameter="{Binding .}"/>        
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>