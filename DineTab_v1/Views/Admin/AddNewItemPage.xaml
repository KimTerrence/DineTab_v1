<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Admin.AddNewItemPage"
             BackgroundColor="#80000000"
             Title="Add New Item">

    <Grid VerticalOptions="Center" HorizontalOptions="Center">
        <Border Padding="20"             
                   BackgroundColor="White"
                   WidthRequest="500"     
                   VerticalOptions="Center"
                   HorizontalOptions="Center">

            <VerticalStackLayout Spacing="20">

                <!-- Header -->
                <Label Text="Create New Item"
                           FontSize="24"
                           HorizontalOptions="Center"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                <!-- Image Upload -->
                <Border 
                           BackgroundColor="#F5F5F5"
                           HeightRequest="150"                    
                           Padding="0">
                    <Grid>
                        <Image Source="{Binding ItemImage}"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HeightRequest="100"
                                   WidthRequest="100"/>
                        <Label Text="Click to upload image"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="Gray"/>
                        <Label Text="PNG, JPG up to 10MB"
                                   FontSize="10"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,10"
                                   TextColor="Gray"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UploadImageCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- Item Name -->
                <Label Text="Item Name*" FontAttributes="Bold" TextColor="Black"/>
                <Border Stroke="Black">
                    <Entry Placeholder="Enter item name"
                               Text="{Binding ItemName}" />
                </Border>

                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*"
                      ColumnSpacing="10" RowSpacing="15">

                    <!-- Price -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                        <Label Text="Price*" FontAttributes="Bold" TextColor="Black"/>
                        <Border Stroke="Black" StrokeThickness="1">
                            <Entry Keyboard="Numeric"
                                   Text="{Binding Price}"
                                   Margin="5"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Category -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                        <Label Text="Category*" FontAttributes="Bold" TextColor="Black"/>
                        <Border Stroke="Black" StrokeThickness="1">
                            <Picker ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedCategory}"
                                    Margin="5"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Availability -->
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                        <Label Text="Availability Status" FontAttributes="Bold" TextColor="Black"/>
                        <Border Stroke="Black" StrokeThickness="1">
                            <Picker ItemsSource="{Binding AvailabilityOptions}"
                                    SelectedItem="{Binding SelectedAvailability}"
                                    Margin="5"/>        
                        </Border>
                    </VerticalStackLayout>

                    <!-- Spicy -->
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label Text="Spicy" FontAttributes="Bold" TextColor="Black"/>
                        <Border Stroke="Black" StrokeThickness="1">
                            <Picker ItemsSource="{Binding SpicyOptions}"
                                    SelectedItem="{Binding SelectedSpicy}"
                                    Margin="5"/>        
                        </Border>
                    </VerticalStackLayout>

                    <!-- Buttons spanning 2 columns -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*"
                          ColumnSpacing="20" Margin="0,10,0,0">

                        <Button Text="Cancel"
                                Command="{Binding CancelCommand}"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="Black"
                                BorderWidth="1"
                                CornerRadius="0"
                                Grid.Column="0"/>

                        <Button Text="Add New Item"
                                Command="{Binding AddItemCommand}"
                                 BackgroundColor="White"
                                 TextColor="Black"
                                 BorderColor="Black"
                                 BorderWidth="1"
                                 CornerRadius="0"
                                Grid.Column="1"/>       
                    </Grid>

                </Grid>


            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
