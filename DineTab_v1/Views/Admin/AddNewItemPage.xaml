<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Admin.AddNewItemPage"
             Title="AddNewItemPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Create New Item"
                   FontSize="24"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"/>

            <!-- Image Upload -->
            <Frame BorderColor="Gray"
                   BackgroundColor="#F5F5F5"
                   HeightRequest="150"
                   CornerRadius="10"
                   HasShadow="False"
                   Padding="0"
                   >
                <Grid>
                    <Image Source="{Binding ItemImage}"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HeightRequest="100"
                           WidthRequest="100"/>
                    <Label Text="Click to upload image"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"/>
                    <Label Text="PNG, JPG up to 10MB"
                           FontSize="10"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           Margin="0,0,0,10"
                           TextColor="Gray"/>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding UploadImageCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Frame>

            <!-- Item Name -->
            <Label Text="Item Name*" FontAttributes="Bold"/>
            <Entry Placeholder="Enter item name"
                   Text="{Binding ItemName}" />

            <!-- Price and Category -->
            <HorizontalStackLayout Spacing="10">
                <VerticalStackLayout HorizontalOptions="FillAndExpand">
                    <Label Text="Price*" FontAttributes="Bold"/>
                    <Entry Keyboard="Numeric"
                           Text="{Binding Price}" />
                </VerticalStackLayout>

                <VerticalStackLayout HorizontalOptions="FillAndExpand">
                    <Label Text="Category*" FontAttributes="Bold"/>
                    <Picker ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}"
                            Title="Select category" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Availability and Spicy -->
            <HorizontalStackLayout Spacing="10">
                <VerticalStackLayout HorizontalOptions="FillAndExpand">
                    <Label Text="Availability Status" FontAttributes="Bold"/>
                    <Picker ItemsSource="{Binding AvailabilityOptions}"
                            SelectedItem="{Binding SelectedAvailability}" />
                </VerticalStackLayout>

                <VerticalStackLayout HorizontalOptions="FillAndExpand">
                    <Label Text="Spicy" FontAttributes="Bold"/>
                    <Picker ItemsSource="{Binding SpicyOptions}"
                            SelectedItem="{Binding SelectedSpicy}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Buttons -->
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <Button Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="White"
                        TextColor="Black"
                        BorderColor="Black"
                        BorderWidth="2"
                        CornerRadius="5"
                        WidthRequest="120"/>
                <Button Text="Add New Item"
                        Command="{Binding AddItemCommand}"
                        BackgroundColor="Black"
                        TextColor="White"
                        CornerRadius="5"
                        WidthRequest="120"/>

            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>