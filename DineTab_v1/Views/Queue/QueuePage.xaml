<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Queue.QueuePage"
             Title="QueuePage">
    <Grid Padding="20" ColumnSpacing="10" RowSpacing="0">
        <!-- Define 3 columns: Image, Preparing, Ready -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Menu Image -->
        <Frame Grid.Column="0" Padding="0" HasShadow="False" BackgroundColor="Transparent">
            <Image Source="menu_sample.png" Aspect="AspectFill"/>
        </Frame>

        <!-- Middle: Preparing Orders -->
        <StackLayout Grid.Column="1" Spacing="10">
            <Label Text="PREPARING" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>

            <!-- Table Headers -->
            <Grid Padding="10" ColumnSpacing="10" RowSpacing="0" BackgroundColor="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Text="Order #" FontAttributes="Bold" Grid.Column="0"/>
                <Label Text="Est. Time" FontAttributes="Bold" Grid.Column="1"/>
            </Grid>

            <CollectionView ItemsSource="{Binding PreparingOrders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnSpacing="10" RowSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Text="{Binding OrderNumber}" Grid.Column="0" FontAttributes="Bold"/>
                            <Label Text="{Binding RemainingTimeString}" Grid.Column="1"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>


        <!-- Right: Ready Orders -->
        <StackLayout Grid.Column="2" Spacing="10">
            <Label Text="READY" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>
            <CollectionView ItemsSource="{Binding ReadyOrders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="5" Margin="0,0,0,10" CornerRadius="5" BorderColor="Gray" BackgroundColor="#f0f0f0">
                            <Label Text="{Binding OrderNumber}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </Grid>
</ContentPage>