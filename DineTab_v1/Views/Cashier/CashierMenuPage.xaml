<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Cashier.CashierMenuPage"
             x:Name="RootPage"
             NavigationPage.HasBackButton="False"
             Shell.NavBarIsVisible="False">
    
    <Grid ColumnDefinitions="*, 300" 
          RowDefinitions="Auto, *" 
          RowSpacing="10">

        <!-- Top Category Icons -->
        <Grid Padding="10" ColumnDefinitions="*, *" >
            <VerticalStackLayout Grid.Column="0">
                <HorizontalStackLayout Spacing="20" >
                    <Label Text="Dine Tab" FontSize="32" FontAttributes="Bold" TextColor="#9A9A9A"/>
                    <Label Text="Orders " FontSize="32" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            <Picker Title="Order Type" WidthRequest="100" HorizontalOptions="Start">
                <Picker.Items>
                    <x:String>Dine In</x:String>
                    <x:String>Take Out</x:String>
                </Picker.Items>
            </Picker>
            </VerticalStackLayout>


            <Button Text="Create Order"
                    Grid.Column="1"
                    HorizontalOptions="End"
                    HeightRequest="50"
                    BackgroundColor="White"
                    TextColor="Black"
                    BorderColor="Black"
                    BorderWidth="1"
                    CornerRadius="0"/>
        </Grid>


        <!-- Menu Items Grid -->
        <CollectionView ItemsSource="{Binding Orders}" Grid.Row="1">
            <CollectionView.ItemsLayout>
                <!-- 4 boxes per row -->
                <GridItemsLayout Orientation="Vertical" Span="4"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" BackgroundColor="#f5f5f5">
                        <VerticalStackLayout Spacing="10" Padding="10">
                            <!-- Order Header -->
                            <Label Text="{Binding OrderNumber}" FontAttributes="Bold" Background="Gray"/>
                            <Label Text="{Binding OrderType}" FontSize="12"/>

                            <!-- Order Items -->
                            <CollectionView ItemsSource="{Binding Items}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,*,*" Padding="5">
                                            <Label Text="{Binding Name}" Grid.Column="0"/>
                                            <Label Text="{Binding Quantity}" Grid.Column="1" HorizontalOptions="Center"/>
                                            <Label Text="{Binding TotalPrice, StringFormat='₱{0:F2}'}" Grid.Column="2" HorizontalOptions="End"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Order Total -->
                            <Label Text="{Binding Total, StringFormat='Total: ₱{0:F2}'}"
                           FontAttributes="Bold"
                           HorizontalOptions="End"/>
                            <Button Text="Add "
                                    HorizontalOptions="End"
                                    BackgroundColor="White"
                                    BorderColor="Black"
                                    BorderWidth="1"
                                    TextColor="Black"
                                    CornerRadius="0"
                                    Command="{Binding BindingContext.AddOrderCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>



        <!-- Order Summary Panel -->
        <Border Stroke="Black" Grid.Column="1" Grid.Row="0"  Grid.RowSpan="2" >
            <VerticalStackLayout Spacing="10" BackgroundColor="#f5f5f5">
                <Border Stroke="Black">
                    <VerticalStackLayout Spacing="10" Padding="10">
                        <HorizontalStackLayout>
                            <Label Text="Order " FontAttributes="Bold" FontSize="16"/>
                            <Label Text="{Binding SelectedOrderNumber}" FontAttributes="Bold" FontSize="16"/>
                        </HorizontalStackLayout>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Start">

                            <Label Text="{Binding SelectedOrderType}" FontSize="16" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <ScrollView>
                    <CollectionView ItemsSource="{Binding OrderItems}" HeightRequest="460">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Transparent" Padding="10">
                                    <VerticalStackLayout Padding="5" BackgroundColor="White">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Item Name -->
                                            <Label Text="{Binding Name}" 
                                                    Grid.Column="0" 
                                                    VerticalOptions="Center" 
                                                    HorizontalOptions="Start"
                                                    FontSize="18"/>

                                            <!-- Remove Button -->
                                            <Button Text="x" 
                                                     Grid.Column="1" 
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Center"
                                                     BackgroundColor="Transparent"
                                                     TextColor="Black"
                                                     Command="{Binding BindingContext.RemoveItemCommand, Source={x:Reference RootPage}}"
                                                      CommandParameter="{Binding}" />
                                        </Grid>

                                        <Grid>
                                            <!-- Item Price -->
                                            <Label Text="{Binding Price, StringFormat='₱{0:F2}'}"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="Start"
                                                    TextColor="#787878"
                                                     FontSize="12"/>

                                            <!-- Quantity Controls -->
                                            <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                                <!-- Decrease Quantity -->
                                                <Button Text="-" 
                                                         WidthRequest="0"
                                                         Command="{Binding BindingContext.DecreaseOrderItemCommand, Source={x:Reference RootPage}}"
                                                         CommandParameter="{Binding}" 
                                                         CornerRadius="30"
                                                         Background="#D9D9D9"
                                                         TextColor="Black"
                                                         FontSize="12"/>
                                                <!-- Quantity Display -->
                                                <Label Text="{Binding Quantity}" 
                                                        FontSize="12" 
                                                        WidthRequest="40"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="Center"/>

                                                <!-- Increase Quantity -->
                                                <Button Text="+" 
                                                         WidthRequest="30"
                                                         Command="{Binding BindingContext.IncreaseOrderItemCommand, Source={x:Reference RootPage}}"
                                                         CommandParameter="{Binding}" 
                                                         CornerRadius="30"
                                                         Background="#D9D9D9"
                                                         TextColor="Black"
                                                         FontSize="12"/>
                                            </HorizontalStackLayout>

                                            <!-- Total Price -->
                                            <Label Text="{Binding TotalPrice, StringFormat='₱{0:F2}'}"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="End"
                                                    FontSize="12"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>

                <Border Stroke="Black" HeightRequest="50" Padding="10">
                    <Label Text="{Binding Total, StringFormat='Total: ₱{0:F2}'}" FontAttributes="Bold" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Spacing="10" Padding="10">
                    <Button Text="Cancel" BackgroundColor="White"
                            BorderColor="Black"
                            BorderWidth="1"
                            CornerRadius="0"
                            TextColor="Black"
                            Command="{Binding CancelOrderCommand}"/>
                    <Button Text="Confirm Payment" BackgroundColor="White"
                            BorderColor="Black"
                            BorderWidth="1"
                            CornerRadius="0"
                            Command="{Binding ConfirmPaymentCommand}"
                            TextColor="Black"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
