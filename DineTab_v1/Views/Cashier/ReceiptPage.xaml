<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Cashier.ReceiptPage"
             Title="Receipt">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" WidthRequest="500">

            <!-- Restaurant Header -->
            <Label Text="Ayer’s Lechon"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Elizabeth Mall, Sanciangko St, Cebu City"
                   FontSize="12"
                   HorizontalOptions="Center" />
            <Label Text="Phone: (639) 345-2020"
                   FontSize="12"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

            <!-- Order Info -->
            <Label Text="{Binding OrderNumber, StringFormat='Order {0}'}"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="{Binding OrderDate, StringFormat='{0:MMMM dd, yyyy}'}"
                   FontSize="14"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

            <!-- Order Details Header -->
            <Label Text="ORDER DETAILS"
                   FontAttributes="Bold"
                   FontSize="14"
                   Margin="0,5" />

            <!-- Order Items -->
            <CollectionView ItemsSource="{Binding OrderItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,5" ColumnDefinitions="*,*,Auto">
                            <!-- Quantity -->
                            <Label Text="{Binding Quantity, StringFormat='{0}x'}"
                                   FontSize="14" />

                            <!-- Item Name & Description -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Name}" 
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding OrderType}"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <!-- Price -->
                            <Label Text="{Binding TotalPrice, StringFormat='₱{0:N2}'}"
                                   Grid.Column="2"
                                   FontSize="14" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

            <!-- Total Amount -->
            <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                <Label Text="Total Amount"
                       FontAttributes="Bold"
                       FontSize="16" />
                <Label Text="{Binding TotalAmount, StringFormat='₱{0:N2}'}"
                       FontAttributes="Bold"
                       FontSize="16"
                       Grid.Column="1" />
            </Grid>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

            <!-- Payment Info -->
            <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                <Label Text="Payment Method" FontSize="14"/>
                <Label Text="{Binding PaymentMethod}" Grid.Column="1" FontSize="14"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                <Label Text="Cash Received" FontSize="14"/>
                <Label Text="{Binding CashReceived, StringFormat='₱{0:N2}'}" Grid.Column="1" FontSize="14"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                <Label Text="Change" FontAttributes="Bold" FontSize="16"/>
                <Label Text="{Binding Change, StringFormat='₱{0:N2}'}"
           Grid.Column="1"
           FontAttributes="Bold"
           FontSize="16"/>
            </Grid>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

            <!-- Footer -->
            <Label Text="Thank you for your order!"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Visit us again soon!"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
