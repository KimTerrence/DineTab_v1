<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Auth.LoginPage">

    <Grid>
        <!-- Define two rows: Top for role selection, Middle for main content -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Role Dropdown -->
        <Picker x:Name="LoginPicker"
                Title="Login As"
                ItemsSource="{Binding Roles}"
                SelectedItem="{Binding SelectedRole}"
                Grid.Row="0"
                Margin="20"
                WidthRequest="100"
                HorizontalOptions="Start"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <!-- Click to Order Button -->
            <Button Text="Click to Order"
                    BackgroundColor="#A1A1A1"
                    TextColor="Black"
                    FontSize="36"
                    CornerRadius="20"
                    WidthRequest="1400"
                    HeightRequest="150"
                    IsVisible="{Binding IsCustomerSelected}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Command="{Binding OrderCommand}"/>

            <!-- Login Form Overlay -->
            <Border BackgroundColor="#D9D9D9"
                    Padding="30"
                    WidthRequest="400"
                    HeightRequest="500"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsLoginFormVisible}"
                    ZIndex="10">
                <VerticalStackLayout Spacing="20" Margin="0,50,0,0">
                    <Label Text="Login" FontSize="44" HorizontalOptions="Center"/>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Email"/>
                        <Border Stroke="Black">
                            <Entry Placeholder="Username" 
                                   Text="{Binding Email}" 
                                   BackgroundColor="White"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <!-- Password -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password"/>
                        <Border Stroke="Black" HeightRequest="48" BackgroundColor="White">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Placeholder="Password"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       BackgroundColor="White"
                                       Grid.Column="0"
                                 />
                                <ImageButton Source="{Binding PasswordToggleIcon}"
                                             Command="{Binding TogglePasswordCommand}"
                                             BackgroundColor="White"
                                             WidthRequest="60"
                                             HeightRequest="80"
                                             Padding="10"
                                             Margin="0"
                                             Grid.Column="1"
                                             HorizontalOptions="End"
                                             VerticalOptions="Center"/>

                            </Grid>
                        </Border>
                        <Button Text="Forgot Password" 
                                HorizontalOptions="End" 
                                Command="{Binding ForgotPasswordCommand}" 
                                BackgroundColor="Transparent" 
                                TextColor="DarkBlue"/>  
                    </VerticalStackLayout>


                    <!-- Login Button -->
                    <Button Text="Login"
                            BackgroundColor="White"
                            BorderColor="Black"
                            BorderWidth="1"
                            TextColor="Black"
                            WidthRequest="200"
                            HorizontalOptions="Center"
                            CornerRadius="0"
                            Command="{Binding LoginCommand}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
