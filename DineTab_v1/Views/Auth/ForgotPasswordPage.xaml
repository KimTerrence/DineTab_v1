<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DineTab_v1.Views.Auth.ForgotPasswordPage"
             NavigationPage.HasNavigationBar="False">

    <Grid VerticalOptions="Center" HorizontalOptions="Center">
        <Border Padding="30"
               BackgroundColor="White"
               WidthRequest="350">

            <VerticalStackLayout Spacing="20">

                <!-- Title -->
                <Label Text="Forgot Password" 
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <!-- Step 1: Email Entry -->
                <VerticalStackLayout>
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Step}"
                                     Value="1">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Step}"
                                     Value="2">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Step}"
                                     Value="3">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label Text="Enter your email:"/>
                    <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email"/>
                </VerticalStackLayout>

                <!-- Step 2: PIN Entry -->
                <VerticalStackLayout>
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Step}"
                                     Value="2">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Step}"
                                     Value="1">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Step}"
                                     Value="3">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label Text="Enter the PIN sent to your email:"/>
                    <Entry Placeholder="PIN" Text="{Binding Pin}" Keyboard="Numeric"/>
                </VerticalStackLayout>

                <!-- Step 3: New Password -->
                <VerticalStackLayout>
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Step}"
                                     Value="3">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Step}"
                                     Value="1">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Step}"
                                     Value="2">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label Text="Enter new password:"/>
                    <Entry Placeholder="New Password" Text="{Binding NewPassword}" IsPassword="True"/>
                    <Label Text="Confirm new password:"/>
                    <Entry Placeholder="Confirm Password" Text="{Binding ConfirmPassword}" IsPassword="True"/>
                </VerticalStackLayout>

                <!-- Buttons -->
                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Button Text="Cancel"
                            BackgroundColor="White"
                            TextColor="Black"
                            WidthRequest="100"
                            BorderColor="Black"
                            BorderWidth="1"
                            Command="{Binding CancelCommand}"/>
                    <Button Text="Confirm"
                            BackgroundColor="White"
                            TextColor="Black"
                            WidthRequest="100"
                            BorderColor="Black"
                            BorderWidth="1"
                            Command="{Binding ConfirmCommand}"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
